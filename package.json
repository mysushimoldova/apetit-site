{
  "name": "apetit-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "playwright test -c playwright.screenshots.config.ts",
    "images": "py -3 scripts/prepare-images.py",
    "test:py": "py -3 -m unittest scripts/test_prepare_images.py",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "telegram:dev": "node scripts/telegram-dev.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "og": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
