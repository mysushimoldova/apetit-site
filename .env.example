# Образец .env.local — скопируй в .env.local и заполни. Сам .env.local в git
# не попадает (.gitignore), содержимое ключей никуда не отправлять.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Заказы: секрет для хэша IP (лимит по IP без хранения адреса) ---
# Создать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_HASH_SECRET=

# --- Telegram (@apetit_comenzi_bot, токен из @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Секрет webhook: та же команда, что выше (только буквы, цифры, _ и -)
TELEGRAM_WEBHOOK_SECRET=
# Секрет будильника напоминаний (pg_cron → /api/telegram/reminders): та же команда
REMINDERS_SECRET=
# Боевой адрес сайта для npm run telegram:setup (без слэша в конце)
SITE_URL=
