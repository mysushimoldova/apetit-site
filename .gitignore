# Исходники (фото, PSD, логотип) — не в git
assets/foto-originale/
assets/meniu-psd/
assets/brand/
assets/splash-video/

# Зависимости
/node_modules

# Сборка Next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Сборка для Cloudflare (OpenNext): npm run build:cf
/.open-next/
/.wrangler/

# Секреты — только в .env.local, никогда в git.
# .dev.vars — запасной файл ключей wrangler; мы им не пользуемся
# (npm run preview:cf читает .env.local), но пусть не попадёт в git случайно.
.env*
!.env.example
.dev.vars*

# Тесты
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Снимки матрицы браузеров: 35 МБ и переснимаются на каждом прогоне
# (npm run test:matrix). В git их не держим — история распухла бы за пару
# задач. Смотреть локально в docs/screens/matrix/.
/docs/screens/matrix/
# Записи движения (npm run motion) — переснимаются каждый раз
/docs/motion/*.webm
/docs/motion/.record/

# Лог последнего прогона матрицы
/matrix.log

# Отчёты Lighthouse (их читает npm run launch:check) — по мегабайту каждый
/docs/qa/lighthouse/

# Разное
.DS_Store
*.pem
npm-debug.log*
.vercel

# Мастер-копии вырезок (PNG в исходном размере) — не в git, только WebP
public/img/products/*.png

# Python (скрипты подготовки фото)
__pycache__/

# Отчёты semgrep (если скилл положит их в корень)
static_analysis_semgrep_*/

